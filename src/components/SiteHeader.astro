---
import { site } from '@/site.config';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label={`${site.name}首页`}>
      <span class="seal" aria-hidden="true">R</span><span aria-hidden="true"
        >Rabbit Hole</span
      >
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <details class="mobile-menu">
      <summary>菜单</summary>
      <nav aria-label="移动端导航">
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
    <button
      class="theme-toggle"
      type="button"
      aria-label="切换颜色主题"
      title="切换颜色主题"
    >
      <span class="sun" aria-hidden="true">☼</span><span class="moon" aria-hidden="true"
        >◐</span
      >
    </button>
    <a class="search-link" href="/search/" aria-label="搜索">⌕</a>
  </div>
</header>

<script is:inline>
  const button = document.querySelector('.theme-toggle');
  const applyTheme = (theme) => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('theme', theme);
    button?.setAttribute('aria-label', `切换到${theme === 'dark' ? '浅色' : '深色'}主题`);
  };
  button?.setAttribute(
    'aria-label',
    `切换到${document.documentElement.dataset.theme === 'dark' ? '浅色' : '深色'}主题`,
  );
  button?.addEventListener('click', () => {
    applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    height: var(--header-height);
    border-block: 1px solid color-mix(in srgb, var(--line-strong) 65%, transparent);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px);
  }
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
  }
  .wordmark {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    justify-self: start;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-decoration: none;
  }
  .seal {
    display: inline-grid;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.76rem;
    letter-spacing: 0;
  }
  .mobile-menu {
    display: none;
  }
  ul {
    display: flex;
    gap: 1.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 560;
    text-decoration: none;
  }
  nav a[aria-current='page'],
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.42rem;
  }
  .theme-toggle {
    display: inline-grid;
    justify-self: end;
    margin-right: 2.8rem;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .search-link {
    position: absolute;
    right: max(1rem, calc((100vw - var(--wide)) / 2));
    color: var(--ink-soft);
    font-size: 1.2rem;
    text-decoration: none;
  }
  .theme-toggle:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: inline;
  }
  @media (max-width: 44rem) {
    .header-inner {
      grid-template-columns: 1fr auto auto;
      gap: 0.75rem;
    }
    .search-link {
      display: none;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
      justify-self: end;
    }
    .mobile-menu summary {
      display: block;
      padding: 0.45rem 0.6rem;
      color: var(--ink-soft);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      cursor: pointer;
      list-style: none;
    }
    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }
    .mobile-menu summary::before {
      content: '+ ';
      color: var(--accent);
    }
    .mobile-menu[open] summary::before {
      content: '− ';
    }
    .mobile-menu nav {
      position: fixed;
      top: var(--header-height);
      right: 0;
      left: 0;
      padding: 0.6rem 1rem 1rem;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
      box-shadow: var(--shadow);
    }
    .mobile-menu ul {
      display: grid;
      gap: 0;
    }
    .mobile-menu li + li {
      border-top: 1px solid var(--line);
    }
    .mobile-menu a {
      display: flex;
      padding: 0.85rem 0.25rem;
      font-size: 0.86rem;
    }
    .mobile-menu a[aria-current='page'] {
      text-decoration: none;
    }
    .theme-toggle {
      width: 2rem;
      height: 2rem;
      margin-right: 0;
    }
    .wordmark {
      font-size: 0.95rem;
    }
  }
</style>
