---
import type { CourseEntry } from '@/lib/content';
import { pluralize } from '@/lib/text';

interface Props {
  course: CourseEntry;
  noteCount: number;
}
const { course, noteCount } = Astro.props;
---

<article class="course-card">
  <p class="meta">
    <span>{course.data.status}</span><span>{pluralize(noteCount, 'note')}</span>{
      course.data.demo && <span>Demo</span>
    }
  </p>
  <h3><a href={`/courses/${course.id}/`}>{course.data.title}</a></h3>
  <p class="description">{course.data.description}</p>
  <ol aria-label="Course topics">
    {course.data.topics.slice(0, 3).map((topic) => <li>{topic}</li>)}
  </ol>
</article>

<style>
  .course-card {
    position: relative;
    padding: 1.4rem 0 1.5rem;
    border-top: 1px solid var(--line);
  }
  .course-card:last-child {
    border-bottom: 1px solid var(--line);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }
  .meta span:first-child {
    color: var(--accent);
  }
  h3 {
    margin: 0.55rem 0 0;
    font-family: ui-serif, Georgia, serif;
    font-size: 1.55rem;
    font-weight: 560;
    letter-spacing: -0.025em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }
  .description {
    max-width: 50rem;
    margin: 0.55rem 0 1rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    list-style-position: inside;
  }
</style>
