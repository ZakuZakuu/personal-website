---
import type { ProjectEntry } from '@/lib/content';
import TagList from './TagList.astro';

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
---

<article class="project-card">
  <div class="project-topline">
    <span class="status"><i aria-hidden="true"></i>{project.data.status}</span>
    {project.data.demo && <span class="demo">示例内容</span>}
  </div>
  <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
  <p>{project.data.description}</p>
  <TagList tags={project.data.tech} linked={false} />
  <span class="arrow" aria-hidden="true">↗</span>
</article>

<style>
  .project-card {
    position: relative;
    min-height: 17rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--paper-raised) 78%, transparent);
    box-shadow: 0 1px 0 rgb(0 0 0 / 2%);
    transition:
      border-color 160ms ease,
      translate 160ms ease,
      box-shadow 160ms ease;
  }
  .project-card:hover {
    translate: 0 -2px;
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }
  .project-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .status i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .demo {
    color: var(--ink-soft);
  }
  h3 {
    max-width: 19ch;
    margin: 2.4rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }
  p {
    max-width: 34rem;
    margin: 0.75rem 0 1.3rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.65;
  }
  :global(.tags) {
    position: relative;
    z-index: 1;
  }
  .arrow {
    position: absolute;
    right: 1.45rem;
    bottom: 1.35rem;
    color: var(--accent);
    font-size: 1.25rem;
  }
</style>
