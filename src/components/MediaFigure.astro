---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  eager?: boolean;
}

const { src, alt, caption, eager = false } = Astro.props;
---

<figure class="media-figure">
  <Image src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media-figure {
    margin: 2.2rem 0;
  }
  .media-figure :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--paper-raised);
  }
  figcaption {
    margin-top: 0.65rem;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    line-height: 1.55;
  }
</style>
