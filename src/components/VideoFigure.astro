---
interface Props {
  src: string;
  title: string;
  poster?: string;
  caption?: string;
}

const { src, title, poster, caption } = Astro.props;
---

<figure class="video-figure">
  <video controls preload="metadata" {poster} aria-label={title}>
    <source src={src} />
    <p>Your browser cannot play this video. <a href={src}>Download it instead.</a></p>
  </video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video-figure {
    margin: 2.2rem 0;
  }
  video {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: #0d0f0e;
  }
  figcaption {
    margin-top: 0.65rem;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    line-height: 1.55;
  }
</style>
