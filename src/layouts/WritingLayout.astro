---
import type { MarkdownHeading } from 'astro';
import ContentCard from '@/components/ContentCard.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import TagList from '@/components/TagList.astro';
import {
  formatDate,
  getRelatedWriting,
  type NoteEntry,
  type WritingEntry,
  writingHref,
} from '@/lib/content';
import { estimateReadingTime } from '@/lib/text';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: WritingEntry;
  headings: MarkdownHeading[];
  courseTitle?: string;
  courseId?: string;
  previous?: NoteEntry;
  next?: NoteEntry;
}

const { entry, headings, courseTitle, courseId, previous, next } = Astro.props;
const related = await getRelatedWriting(entry);
const kind = entry.collection === 'articles' ? 'Article' : 'Note';
const minutes = estimateReadingTime(entry.body ?? '');
---

<BaseLayout title={entry.data.title} description={entry.data.description} article>
  <article class="article-shell" data-pagefind-body>
    <header class="article-header reading-width">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/writing/">Writing</a>
        {
          courseId && courseTitle && (
            <>
              <>
                <span aria-hidden="true">/</span>
                <a href={`/courses/${courseId}/`}>{courseTitle}</a>
              </>
            </>
          )
        }
      </nav>
      <p class="eyebrow">{kind}{entry.data.demo ? ' · Demo content' : ''}</p>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="description">{entry.data.description}</p>
      <div class="article-meta">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        <span>{minutes} min read</span>
        {entry.data.updated && <span>Updated {formatDate(entry.data.updated)}</span>}
      </div>
      <TagList tags={entry.data.tags} />
    </header>

    <div class="article-grid shell">
      <aside class="toc-column"><TableOfContents headings={headings} /></aside>
      <div class="prose"><slot /></div>
    </div>

    {
      (previous || next) && (
        <nav class="sequence reading-width" aria-label="Course note navigation">
          {previous ? (
            <a class="previous" href={writingHref(previous)}>
              <small>Previous note</small>
              <span>← {previous.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="next" href={writingHref(next)}>
              <small>Next note</small>
              <span>{next.data.title} →</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="related reading-width">
          <p class="eyebrow">Continue reading</p>
          <h2>Related writing</h2>
          <div>
            {related.map((item) => (
              <ContentCard entry={item} compact />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .article-shell {
    padding-top: 2.25rem;
  }
  .breadcrumbs {
    display: flex;
    gap: 0.55rem;
    margin-bottom: 1.5rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.69rem;
  }
  .breadcrumbs a {
    text-decoration: none;
  }
  h1 {
    max-width: 18ch;
    margin: 0.5rem 0 0;
    font-family: ui-serif, Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 520;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .description {
    max-width: 39rem;
    margin: 1rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-block: 1.35rem 1rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }
  .article-grid {
    display: grid;
    grid-template-columns: minmax(8rem, 13rem) minmax(0, var(--content)) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: 2.5rem;
  }
  .toc-column {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    align-self: start;
  }
  .sequence {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 5rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }
  .sequence a {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
  }
  .sequence .next {
    text-align: right;
  }
  .sequence small {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .sequence span {
    font-family: ui-serif, Georgia, serif;
    font-size: 1rem;
  }
  .related {
    margin-top: 5.5rem;
  }
  .related h2 {
    margin: 0.6rem 0 1.8rem;
    font-family: ui-serif, Georgia, serif;
    font-size: 2rem;
    font-weight: 540;
    letter-spacing: -0.035em;
  }
  @media (max-width: 63rem) {
    .article-grid {
      grid-template-columns: minmax(0, var(--content));
      justify-content: center;
    }
    .toc-column {
      position: static;
    }
    .margin-note {
      display: none;
    }
  }
  @media (max-width: 38rem) {
    .sequence {
      grid-template-columns: 1fr;
    }
    .sequence .next {
      text-align: left;
    }
  }
</style>
