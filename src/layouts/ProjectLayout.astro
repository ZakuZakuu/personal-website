---
import ContentCard from '@/components/ContentCard.astro';
import TagList from '@/components/TagList.astro';
import { formatDate, getWriting, type ProjectEntry } from '@/lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const writing = await getWriting();
const related = project.data.related
  .map((id) => writing.find((entry) => entry.id === id))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));
---

<BaseLayout title={project.data.title} description={project.data.description} article>
  <article data-pagefind-body>
    <header class="project-hero shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/projects/">Projects</a><span aria-hidden="true">/</span><span
          >{project.data.status}</span
        >
      </nav>
      <div class="title-row">
        <div>
          <p class="eyebrow">Case study{project.data.demo ? ' · Demo content' : ''}</p>
          <h1 data-pagefind-meta="title">{project.data.title}</h1>
        </div>
        <p class="index" aria-hidden="true">P/{formatDate(project.data.date).slice(-4)}</p>
      </div>
      <p class="description">{project.data.description}</p>
      <div class="project-meta">
        <span class="status"><i aria-hidden="true"></i>{project.data.status}</span>
        <TagList tags={project.data.tech} linked={false} />
        {
          (project.data.github || project.data.demoUrl) && (
            <nav aria-label="Project links">
              {project.data.github && <a href={project.data.github}>GitHub ↗</a>}
              {project.data.demoUrl && <a href={project.data.demoUrl}>Live demo ↗</a>}
            </nav>
          )
        }
      </div>
    </header>
    <div class="prose project-prose reading-width"><slot /></div>
    {
      related.length > 0 && (
        <section class="related reading-width">
          <h2>Related writing</h2>
          {related.map((entry) => (
            <ContentCard entry={entry} compact />
          ))}
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .project-hero {
    padding-block: clamp(4rem, 9vw, 7rem) clamp(3.5rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }
  .breadcrumbs {
    display: flex;
    gap: 0.55rem;
    margin-bottom: 3.5rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    text-transform: capitalize;
  }
  .breadcrumbs a {
    text-decoration: none;
  }
  .title-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  h1 {
    max-width: 16ch;
    margin: 0.85rem 0 0;
    font-family: ui-serif, Georgia, serif;
    font-size: clamp(3rem, 8vw, 6.8rem);
    font-weight: 510;
    letter-spacing: -0.07em;
    line-height: 0.94;
  }
  .index {
    margin: 0;
    color: var(--line-strong);
    font-family: var(--font-mono);
    font-size: clamp(2rem, 7vw, 5rem);
    letter-spacing: -0.08em;
  }
  .description {
    max-width: 43rem;
    margin: 1.75rem 0 0;
    color: var(--ink-soft);
    font-size: 1.15rem;
    line-height: 1.7;
  }
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }
  .status i {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .project-meta nav {
    display: flex;
    gap: 1rem;
    margin-left: auto;
    font-size: 0.8rem;
  }
  .project-prose {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }
  .related {
    margin-top: 5.5rem;
  }
  .related h2 {
    margin: 0.6rem 0 1.8rem;
    font-family: ui-serif, Georgia, serif;
    font-size: 2rem;
    font-weight: 540;
    letter-spacing: -0.035em;
  }
  @media (max-width: 38rem) {
    .index {
      display: none;
    }
    .project-meta nav {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
