---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageHeader from '@/components/PageHeader.astro';
import RecordList from '@/components/RecordList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { entryHref, getSeriesEntries } from '@/lib/content';

export async function getStaticPaths() {
  const series = await getCollection('series', ({ data }) => !data.draft);
  return series.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'series'> };
const { Content } = await render(entry);
const entries = await getSeriesEntries(entry.id);
const records = entries.map((item) => ({
  title: item.data.title,
  description: item.data.description,
  date: item.data.date,
  href: entryHref(item),
  tags: item.data.tags,
  series: [],
}));
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <PageHeader title={entry.data.title} />
  <div class="shell series-page">
    <div class="series-intro prose"><Content /></div>
    <section aria-labelledby="series-records-title">
      <h2 id="series-records-title" class="visually-hidden">收录条目</h2>
      <RecordList {records} numbered />
    </section>
  </div>
</BaseLayout>

<style>
  .series-page {
    max-width: 58rem;
  }
  .series-intro {
    max-width: 42rem;
    margin-bottom: 2.5rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
