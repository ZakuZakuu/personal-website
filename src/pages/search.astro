---
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search the writing, projects, and courses on this site."
>
  <Fragment slot="head">
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>
  </Fragment>
  <PageHeader
    eyebrow="Search"
    title="Find an idea again."
    lede="Search runs entirely in the browser over an index generated during the production build."
  />
  <section class="shell search-shell" aria-label="Site search">
    <pagefind-config excerpt-length="28"></pagefind-config>
    <pagefind-input placeholder="Search notes, articles, projects…"></pagefind-input>
    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
    <noscript
      >Search requires JavaScript. The <a href="/archive/">archive</a> remains available.</noscript
    >
    <p class="search-hint">Try a concept, project, or phrase from the archive.</p>
  </section>
</BaseLayout>

<style>
  .search-shell {
    max-width: 52rem;
    min-height: 18rem;
  }
  .search-hint {
    margin-top: 2rem;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }
  pagefind-input,
  pagefind-results,
  pagefind-summary {
    display: block;
  }
  pagefind-summary {
    margin-block: 1.5rem 0.75rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  pagefind-results {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--line);
  }
</style>
