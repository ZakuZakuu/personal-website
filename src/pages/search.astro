---
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="搜索思构录中的文章、项目和课程。">
  <Fragment slot="head">
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>
  </Fragment>
  <PageHeader title="搜索" />
  <section class="shell search-shell" aria-label="Site search">
    <pagefind-config excerpt-length="28"></pagefind-config>
    <pagefind-input placeholder="搜索笔记、文章或项目…"></pagefind-input>
    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
    <noscript>搜索需要 JavaScript。你仍然可以使用<a href="/archive/">归档</a>。</noscript>
    <p class="search-hint">试试输入一个概念、项目或曾经读到的短语。</p>
  </section>
</BaseLayout>

<style>
  .search-shell {
    max-width: 52rem;
    min-height: 18rem;
  }
  .search-hint {
    margin-top: 2rem;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }
  pagefind-input,
  pagefind-results,
  pagefind-summary {
    display: block;
  }
  pagefind-summary {
    margin-block: 1.5rem 0.75rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  pagefind-results {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--line);
  }
</style>
