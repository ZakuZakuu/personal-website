---
import { render } from 'astro:content';
import { getProjects, type ProjectEntry } from '@/lib/content';
import EntryLayout from '@/layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<EntryLayout entry={project} {headings}><Content /></EntryLayout>
