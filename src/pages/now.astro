---
import { getCollection, render } from 'astro:content';
import { formatDate } from '@/lib/content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const snapshots = await getCollection('now', ({ data }) => !data.draft);
const current = snapshots.sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf(),
)[0];
if (!current) throw new Error('A published Now entry is required.');
const { Content } = await render(current);
---

<BaseLayout title="近况" description={current.data.description}>
  <article class="now-page reading-width" data-pagefind-body>
    <header>
      <p class="eyebrow">近况{current.data.demo ? ' · 示例提示' : ''}</p><h1
        data-pagefind-meta="title"
      >
        此刻正在发生的事。
      </h1><p>
        更新于 <time datetime={current.data.updated.toISOString()}
          >{formatDate(current.data.updated)}</time
        >。这个页面受 <a href="https://nownownow.com/about">/now page movement ↗</a> 启发。
      </p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .now-page {
    padding-top: clamp(4rem, 9vw, 7rem);
  }
  header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    max-width: 13ch;
    margin: 0.8rem 0 1.2rem;
    font-family: ui-serif, Georgia, serif;
    font-size: clamp(3rem, 8vw, 5.8rem);
    font-weight: 520;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }
  header p:last-child {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.69rem;
  }
  .prose {
    margin-top: 3rem;
  }
</style>
