---
import { getCollection, render } from 'astro:content';
import { formatDate } from '@/lib/content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const snapshots = await getCollection('now', ({ data }) => !data.draft);
const current = snapshots.sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf(),
)[0];
if (!current) throw new Error('A published Now entry is required.');
const { Content } = await render(current);
---

<BaseLayout title="近况" description={current.data.description}>
  <article class="now-page reading-width" data-pagefind-body>
    <header>
      <h1 data-pagefind-meta="title">近况</h1><p>
        更新于 <time datetime={current.data.updated.toISOString()}
          >{formatDate(current.data.updated)}</time
        >{current.data.demo ? ' · 示例内容' : ''}
      </p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .now-page {
    padding-top: 2.25rem;
  }
  header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    margin: 0 0 0.75rem;
    font-family: ui-serif, Georgia, serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  header p:last-child {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.69rem;
  }
  .prose {
    margin-top: 2rem;
  }
</style>
