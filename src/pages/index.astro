---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getProjects, getWriting, writingHref } from '@/lib/content';

const [writing, projects] = await Promise.all([getWriting(), getProjects()]);
const currentProject = projects[0];
const records = [
  ...writing.map((entry) => ({
    kind: entry.collection === 'articles' ? '文章' : '笔记',
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    href: writingHref(entry),
  })),
  ...projects.map((entry) => ({
    kind: '项目',
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    href: `/projects/${entry.id}/`,
  })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 8);
---

<BaseLayout>
  <h1 class="visually-hidden">思构录</h1>
  {
    currentProject && (
      <section class="forming" aria-labelledby="forming-title">
        <div class="shell forming-inner">
          <div>
            <>
              <p class="eyebrow">正在形成</p>
              <span>NOW</span>
            </>
          </div>
          <div class="forming-copy">
            <h2 id="forming-title">{currentProject.data.title}</h2>
            <p>{currentProject.data.description}</p>
          </div>
          <a href={`/projects/${currentProject.id}/`}>查看项目 →</a>
        </div>
      </section>
    )
  }

  <section class="shell records" id="records" aria-labelledby="records-title">
    <header>
      <h2 id="records-title">近期记录</h2>
      <a href="/archive/">全部归档 →</a>
    </header>
    <ol>
      {
        records.map((record, index) => (
          <li>
            <a href={record.href}>
              <span class="number">{String(index + 1).padStart(2, '0')}</span>
              <div class="record-copy">
                <div class="meta">
                  <>
                    <span>{record.kind}</span>
                    <time datetime={record.date.toISOString()}>
                      {formatDate(record.date)}
                    </time>
                  </>
                </div>
                <>
                  <h3>{record.title}</h3>
                  <p>{record.description}</p>
                </>
              </div>
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <a class="archive-link" href="/archive/">查看全部归档 →</a>
  </section>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .forming a,
  .archive-link {
    color: var(--accent);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .forming {
    border-block: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper-raised) 64%, transparent);
  }
  .forming-inner {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: 1.5rem;
  }
  .forming-inner span {
    color: var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }
  .forming-copy h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 3vw, 2.1rem);
    font-weight: 560;
  }
  .forming-copy p {
    max-width: 42rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .records {
    padding-block: 2.5rem 5rem;
  }
  .records > header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }
  .records h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 560;
    line-height: 1.2;
  }
  .records > header a {
    color: var(--accent);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .records ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }
  .records li {
    border-bottom: 1px solid var(--line);
  }
  .records li > a {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding-block: 1.35rem;
    text-decoration: none;
  }
  .number,
  .meta {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }
  .meta {
    display: flex;
    gap: 0.85rem;
  }
  .meta span {
    color: var(--accent);
  }
  .record-copy h3 {
    margin: 0.45rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    font-weight: 560;
    line-height: 1.35;
  }
  .record-copy p {
    max-width: 48rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.87rem;
    line-height: 1.7;
  }
  .arrow {
    color: var(--line-strong);
  }
  .records li > a:hover :is(.arrow, h3) {
    color: var(--accent);
  }
  .archive-link {
    display: inline-block;
    margin-top: 2rem;
  }
  @media (max-width: 44rem) {
    .forming-inner {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .records li > a {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.75rem;
    }
    .records .arrow {
      display: none;
    }
  }
</style>
