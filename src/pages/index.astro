---
import RecordList from '@/components/RecordList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContentRecords, getProjects, getTagIndex, getWriting } from '@/lib/content';

const [records, projects, writing] = await Promise.all([
  getContentRecords(),
  getProjects(),
  getWriting(),
]);
const currentProject = projects[0];
const tags = getTagIndex(writing).slice(0, 10);
---

<BaseLayout>
  <h1 class="visually-hidden">Rabbit Hole</h1>
  <div class="shell front-page">
    <section aria-labelledby="records-title">
      <header class="section-header">
        <div><span>卷一</span><h2 id="records-title">近期记录</h2></div>
        <a href="/writing/">全部记录 →</a>
      </header>
      <RecordList records={records.slice(0, 10)} numbered />
    </section>

    <aside class="side-column" aria-label="站点索引">
      {
        currentProject && (
          <section class="desk-note" aria-labelledby="forming-title">
            <p class="section-label">案头 · 正在形成</p>
            <h2 id="forming-title">{currentProject.data.title}</h2>
            <p>{currentProject.data.description}</p>
            <a href={`/projects/${currentProject.id}/`}>查看记录 →</a>
          </section>
        )
      }
      <section class="tag-index" aria-labelledby="tag-title">
        <div class="side-heading">
          <h2 id="tag-title">索引</h2><a href="/tags/">全部</a>
        </div>
        <ul>
          {
            tags.map((tag) => (
              <li>
                <a href={`/tags/${tag.slug}/`}>
                  <>
                    <span>{tag.label}</span>
                    <small>{tag.count}</small>
                  </>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <nav class="utility-links" aria-label="其他入口">
        <a href="/now/">近况</a><a href="/archive/">按年份归档</a><a href="/rss.xml">RSS</a>
      </nav>
    </aside>
  </div>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .front-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    padding-block: 2.5rem 5rem;
  }
  .section-header,
  .section-header > div,
  .side-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
  }
  .section-header {
    margin-bottom: 1.2rem;
  }
  .section-header > div {
    justify-content: flex-start;
  }
  .section-header span,
  .section-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 600;
  }
  a {
    font-size: 0.76rem;
    text-decoration: none;
  }
  .side-column {
    border-left: 1px solid var(--line);
    padding-left: 1.5rem;
  }
  .side-column section {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .side-column section + section {
    padding-top: 2rem;
  }
  .desk-note {
    position: relative;
  }
  .desk-note::after {
    position: absolute;
    top: -0.35rem;
    right: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    content: '构';
    font-family: var(--font-serif);
    line-height: 2rem;
    text-align: center;
    transform: rotate(3deg);
  }
  .desk-note h2 {
    margin-top: 1rem;
    padding-right: 2.25rem;
    font-size: 1.2rem;
    line-height: 1.45;
  }
  .desk-note > p:not(.section-label) {
    margin: 0.65rem 0 1rem;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 0.86rem;
    line-height: 1.75;
  }
  .side-heading h2 {
    font-size: 1.15rem;
  }
  .tag-index ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tag-index li + li {
    border-top: 1px dotted var(--line);
  }
  .tag-index li a {
    display: flex;
    justify-content: space-between;
    padding-block: 0.48rem;
    font-size: 0.78rem;
  }
  .tag-index small {
    color: var(--ink-soft);
    font-family: var(--font-mono);
  }
  .utility-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    padding-top: 1.5rem;
  }
  @media (max-width: 48rem) {
    .front-page {
      grid-template-columns: 1fr;
    }
    .side-column {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      border-top: 1px solid var(--ink);
      border-left: 0;
      padding-top: 2rem;
      padding-left: 0;
    }
    .side-column section + section {
      padding-top: 0;
    }
    .utility-links {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 34rem) {
    .side-column {
      grid-template-columns: 1fr;
    }
    .utility-links {
      grid-column: auto;
    }
  }
</style>
