---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getProjects, getWriting, writingHref } from '@/lib/content';

const [writing, projects] = await Promise.all([getWriting(), getProjects()]);
const currentProject = projects[0];
const records = [
  ...writing.map((entry) => ({
    kind: entry.collection === 'articles' ? '文章' : '笔记',
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    href: writingHref(entry),
  })),
  ...projects.map((entry) => ({
    kind: '项目',
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    href: `/projects/${entry.id}/`,
  })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 8);
---

<BaseLayout>
  <section class="shell hero">
    <div class="title-block">
      <p class="seal" aria-hidden="true">思<br />构</p>
      <div><p class="eyebrow">一处持续生长的数字手稿</p><h1>思构录</h1></div>
    </div>
    <p class="lede">记录学习、构建与理解发生的地方。</p>
    <p class="introduction">
      这里收录技术写作、学习笔记和项目实践。与其只保留最后的答案，我更想记下问题如何出现，以及理解如何在过程中改变。
    </p>
    <nav aria-label="快速入口">
      <a href="#records">阅读近期记录 ↓</a><a href="/about/">关于思构录</a>
    </nav>
  </section>

  {
    currentProject && (
      <section class="forming" aria-labelledby="forming-title">
        <div class="shell forming-inner">
          <div>
            <>
              <p class="eyebrow">正在形成</p>
              <span>NOW</span>
            </>
          </div>
          <div class="forming-copy">
            <h2 id="forming-title">{currentProject.data.title}</h2>
            <p>{currentProject.data.description}</p>
          </div>
          <a href={`/projects/${currentProject.id}/`}>查看项目 →</a>
        </div>
      </section>
    )
  }

  <section class="shell records" id="records" aria-labelledby="records-title">
    <header>
      <p class="eyebrow">近期记录</p><h2 id="records-title">
        按它们进入思构录的时间排列。
      </h2>
    </header>
    <ol>
      {
        records.map((record, index) => (
          <li>
            <a href={record.href}>
              <span class="number">{String(index + 1).padStart(2, '0')}</span>
              <div class="record-copy">
                <div class="meta">
                  <>
                    <span>{record.kind}</span>
                    <time datetime={record.date.toISOString()}>
                      {formatDate(record.date)}
                    </time>
                  </>
                </div>
                <>
                  <h3>{record.title}</h3>
                  <p>{record.description}</p>
                </>
              </div>
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <a class="archive-link" href="/archive/">查看全部归档 →</a>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: min(48rem, calc(100svh - var(--header-height)));
    padding-block: clamp(5.5rem, 13vw, 10rem) clamp(5rem, 10vw, 8rem);
  }
  .title-block {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: flex-start;
  }
  .seal {
    width: 2.8rem;
    margin: 0.15rem 0 0;
    padding: 0.35rem 0;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 0.8rem;
    line-height: 1.25;
    text-align: center;
  }
  h1 {
    margin: 0.7rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 12vw, 8.8rem);
    font-weight: 520;
    letter-spacing: 0.08em;
    line-height: 0.95;
  }
  .lede {
    max-width: 30em;
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    line-height: 1.7;
  }
  .introduction {
    max-width: 40rem;
    margin: 1.4rem 0 0;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    line-height: 1.9;
  }
  .hero nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }
  .hero nav a,
  .forming a,
  .archive-link {
    color: var(--accent);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .forming {
    border-block: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper-raised) 64%, transparent);
  }
  .forming-inner {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: 2.5rem;
  }
  .forming-inner span {
    color: var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }
  .forming-copy h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 3vw, 2.1rem);
    font-weight: 560;
  }
  .forming-copy p {
    max-width: 42rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .records {
    padding-block: clamp(5rem, 11vw, 9rem);
  }
  .records > header {
    display: grid;
    grid-template-columns: 9rem minmax(0, 36rem);
    gap: clamp(2rem, 6vw, 6rem);
    margin-bottom: 3rem;
  }
  .records h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3.5vw, 2.6rem);
    font-weight: 520;
    line-height: 1.4;
  }
  .records ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }
  .records li {
    border-bottom: 1px solid var(--line);
  }
  .records li > a {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding-block: 1.8rem;
    text-decoration: none;
  }
  .number,
  .meta {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }
  .meta {
    display: flex;
    gap: 0.85rem;
  }
  .meta span {
    color: var(--accent);
  }
  .record-copy h3 {
    margin: 0.45rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    font-weight: 560;
    line-height: 1.35;
  }
  .record-copy p {
    max-width: 48rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.87rem;
    line-height: 1.7;
  }
  .arrow {
    color: var(--line-strong);
  }
  .records li > a:hover :is(.arrow, h3) {
    color: var(--accent);
  }
  .archive-link {
    display: inline-block;
    margin-top: 2rem;
  }
  @media (max-width: 44rem) {
    .hero {
      min-height: auto;
    }
    .forming-inner,
    .records > header {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .records li > a {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.75rem;
    }
    .records .arrow {
      display: none;
    }
  }
</style>
