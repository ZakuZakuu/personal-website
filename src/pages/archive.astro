---
import ContentCard from '@/components/ContentCard.astro';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEntries } from '@/lib/content';

const entries = await getEntries();
const byYear = Map.groupBy(entries, (entry) => entry.data.date.getUTCFullYear());
---

<BaseLayout title="归档" description="按首次发布时间整理的文章与笔记。">
  <PageHeader title="归档" />
  <div class="shell archive">
    {
      [...byYear.entries()].map(([year, entries]) => (
        <section aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <div>
            {entries.map((entry) => (
              <ContentCard entry={entry} compact />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .archive {
    display: grid;
    gap: 4rem;
    max-width: 55rem;
  }
  section {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 2rem;
  }
  h2 {
    margin: 1rem 0 0;
    color: var(--line-strong);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
  }
  @media (max-width: 36rem) {
    section {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
