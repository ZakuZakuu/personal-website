---
import { render, type CollectionEntry } from 'astro:content';
import { getEntries, type Entry } from '@/lib/content';
import EntryLayout from '@/layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: Entry;
}
const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry as CollectionEntry<'articles'>);
---

<EntryLayout {entry} {headings}><Content /></EntryLayout>
