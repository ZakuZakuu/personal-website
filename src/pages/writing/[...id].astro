---
import { render, type CollectionEntry } from 'astro:content';
import { getCourses, getCourseNotes, getWriting, type WritingEntry } from '@/lib/content';
import WritingLayout from '@/layouts/WritingLayout.astro';

export async function getStaticPaths() {
  const writing = await getWriting();
  return writing.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: WritingEntry;
}
const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry as CollectionEntry<'articles'>);

let courseTitle: string | undefined;
let courseId: string | undefined;
let previous: CollectionEntry<'notes'> | undefined;
let next: CollectionEntry<'notes'> | undefined;

if (entry.collection === 'notes' && entry.data.course) {
  courseId = entry.data.course;
  const [courses, courseNotes] = await Promise.all([
    getCourses(),
    getCourseNotes(courseId),
  ]);
  courseTitle = courses.find((course) => course.id === courseId)?.data.title;
  const index = courseNotes.findIndex((note) => note.id === entry.id);
  previous = index > 0 ? courseNotes[index - 1] : undefined;
  next = index >= 0 && index < courseNotes.length - 1 ? courseNotes[index + 1] : undefined;
}
---

<WritingLayout {entry} {headings} {courseTitle} {courseId} {previous} {next}
  ><Content /></WritingLayout
>
