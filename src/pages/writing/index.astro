---
import PageHeader from '@/components/PageHeader.astro';
import RecordList from '@/components/RecordList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContentRecords } from '@/lib/content';

const records = await getContentRecords();
---

<BaseLayout title="全部记录" description="Rabbit Hole 中按时间展开的全部记录。">
  <PageHeader title="全部记录">
    <nav class="tools" aria-label="记录浏览工具">
      <span>共 {records.length} 篇</span><a href="/tags/">按标签浏览</a><a href="/archive/"
        >按年份归档</a
      ><a href="/search/">搜索</a>
    </nav>
  </PageHeader>
  <section class="shell records" data-pagefind-body>
    <RecordList {records} numbered />
  </section>
</BaseLayout>

<style>
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    margin-left: auto;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .tools a {
    text-decoration: none;
  }
  .records {
    max-width: 58rem;
  }
</style>
