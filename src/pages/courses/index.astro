---
import CourseCard from '@/components/CourseCard.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCourses, getCourseNotes } from '@/lib/content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const courses = await getCourses();
const coursesWithCounts = await Promise.all(
  courses.map(async (course) => ({
    course,
    noteCount: (await getCourseNotes(course.id)).length,
  })),
);
---

<BaseLayout title="课程" description="由站内笔记组成的有序学习路径。">
  <PageHeader title="课程" />
  <section class="shell course-list" aria-label="Courses">
    {coursesWithCounts.map(({ course, noteCount }) => <CourseCard {course} {noteCount} />)}
  </section>
</BaseLayout>

<style>
  .course-list {
    max-width: 55rem;
  }
</style>
