{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test src/**/*.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "new:note": "node scripts/new-content.mjs note",
    "new:article": "node scripts/new-content.mjs article",
    "new:project": "node scripts/new-content.mjs project",
    "new:course": "node scripts/new-content.mjs course",
    "media:image": "node scripts/media/optimize-image.mjs",
    "media:social-card": "node scripts/media/generate-social-card.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "katex": "^0.16.22",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.0"
  }
}
